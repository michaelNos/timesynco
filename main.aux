\@writefile{lof}{\contentsline {figure}{\numberline {C.4}{\ignorespaces Logical DCF77 time difference between two synchronization boards over time. Most samples remain close to zero, while temporary larger differences correspond to synchronization transitions or minute-boundary effects.}}{83}{figure.caption.13}\protected@file@percent }
\newlabel{fig:dcfDiffOverTime}{{C.4}{83}{Logical DCF77 time difference between two synchronization boards over time. Most samples remain close to zero, while temporary larger differences correspond to synchronization transitions or minute-boundary effects}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {C.5}{\ignorespaces Histogram of logical DCF77 time differences between two synchronization boards. The distribution shows that most samples are concentrated near zero during stable operation.}}{83}{figure.caption.14}\protected@file@percent }
